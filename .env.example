# .env.example
# Copy to .env and fill in all values

# ── Firebase ───────────────────────────────────────────────────────────────────
# OPTION A: Path to downloaded serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# OPTION B: Entire JSON as a string (for CI/CD environments)
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project",...}

# ── OpenWeatherMap ────────────────────────────────────────────────────────────
# Free tier supports 60 calls/min — sufficient for APEX
# Get key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
FF1_CACHE_PATH=./data/ff1_cache

# ── Live Collector Relay ──────────────────────────────────────────────────────
# In production the backend can't reach F1's live stream (Cloud Run IP is 403-blocked),
# so a local relay (f1_local_relay.py) on a residential IP pushes frames to the backend.
# Set DISABLE_LIVE_SIGNALR=true on Cloud Run; leave false for local dev if you want the
# backend to try connecting directly.
DISABLE_LIVE_SIGNALR=false
# Shared secret the relay must present (header X-Ingest-Secret). Use a long random string.
# Must be identical on the backend and in the relay's LIVE_INGEST_SECRET env var.
LIVE_INGEST_SECRET=
